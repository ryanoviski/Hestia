<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.github.ryanoviski.hestia.presentation.controllers.CalendarController" spacing="12" styleClass="view">
 <HBox alignment="CENTER_LEFT" spacing="8"><Button text="Anterior" onAction="#previous" styleClass="secondary-button"/><Button text="Hoje" onAction="#today" styleClass="secondary-button"/><Button text="Próximo" onAction="#next" styleClass="secondary-button"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="monthTitle" styleClass="view-heading"/></HBox>
 <FlowPane hgap="8" vgap="8" styleClass="filter-bar"><ComboBox fx:id="typeFilter" promptText="Todos os tipos"/><ComboBox fx:id="statusFilter" promptText="Todas as situações"/><ComboBox fx:id="profileFilter" promptText="Todos os perfis"/><ComboBox fx:id="categoryFilter" promptText="Todas as categorias"/><ComboBox fx:id="originFilter" promptText="Todas as origens"/><Button text="Aplicar" onAction="#refresh" styleClass="primary-button"/></FlowPane>
 <Label fx:id="summary" wrapText="true" styleClass="profile-meta"/><GridPane fx:id="calendarGrid" VBox.vgrow="ALWAYS"/>
</VBox>
