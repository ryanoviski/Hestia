<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="io.github.ryanoviski.hestia.presentation.controllers.ProfilesController"
           alignment="TOP_CENTER" minWidth="0" minHeight="0" styleClass="page-shell">
<VBox fx:id="pageContent" minWidth="0" minHeight="0" spacing="18" styleClass="view,page-frame">
    <HBox alignment="CENTER_LEFT">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Perfis" styleClass="view-heading"/>
            <Label text="Separe o que é individual do que pertence à família ou ao casal."
                   wrapText="true" styleClass="view-subtitle"/>
        </VBox>
        <Label fx:id="profileCount" styleClass="count-pill"/>
        <Button text="Novo perfil" onAction="#createProfile" styleClass="primary-button"/>
    </HBox>
    <VBox minWidth="0" minHeight="0" spacing="10" VBox.vgrow="ALWAYS">
        <ScrollPane minHeight="0" maxHeight="Infinity" fitToWidth="true" hbarPolicy="NEVER"
                    VBox.vgrow="ALWAYS" styleClass="content-scroll,styled-scroll">
            <VBox fx:id="profilesList" spacing="9" styleClass="financial-list">
                <VBox fx:id="emptyState" alignment="CENTER" spacing="7" styleClass="empty-state-large">
                    <Label text="Nenhum perfil cadastrado" styleClass="empty-title"/>
                    <Label text="Crie uma pessoa ou um perfil compartilhado para começar." wrapText="true" styleClass="empty-description"/>
                </VBox>
            </VBox>
        </ScrollPane>
        <Label fx:id="formMessage" wrapText="true" styleClass="feedback-text"/>
    </VBox>
</VBox>
</StackPane>
