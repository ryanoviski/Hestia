<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.FlowPane?>
<?import io.github.ryanoviski.hestia.presentation.components.ColorPalette?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="io.github.ryanoviski.hestia.presentation.controllers.ProfilesController"
      spacing="18" styleClass="view">
    <VBox spacing="5">
        <Label text="Perfis da família" styleClass="view-heading" />
        <Label text="Organize até cinco perfis ativos para representar pessoas ou o uso compartilhado." wrapText="true" styleClass="view-subtitle" />
    </VBox>
    <FlowPane hgap="20" vgap="20" prefWrapLength="980" VBox.vgrow="ALWAYS">
      <VBox spacing="16" minWidth="480" prefWidth="620">
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="profiles-scroll">
            <VBox fx:id="profilesList" spacing="10" styleClass="profiles-list">
                <Label fx:id="emptyState" text="Nenhum perfil cadastrado. Use o formulário ao lado para começar." wrapText="true" styleClass="empty-state" />
            </VBox>
        </ScrollPane>
      </VBox>
      <VBox minWidth="330" prefWidth="350" spacing="13" styleClass="form-card">
        <Label fx:id="formTitle" text="Novo perfil" styleClass="panel-title" />
        <Label text="Nome *" styleClass="field-label" />
        <TextField fx:id="nameField" promptText="Ex.: Ana" />
        <Label text="Tipo *" styleClass="field-label" />
        <ComboBox fx:id="typeField" maxWidth="Infinity" />
        <Label text="Cor" styleClass="field-label" />
        <ColorPalette fx:id="colorPalette" maxWidth="Infinity" />
        <Label text="Escolha uma cor para identificar o perfil visualmente." wrapText="true" styleClass="field-hint" />
        <Label fx:id="formMessage" wrapText="true" />
        <Button fx:id="saveButton" text="Cadastrar perfil" maxWidth="Infinity" onAction="#saveProfile" styleClass="primary-button" />
        <Button fx:id="cancelEditButton" text="Cancelar edição" maxWidth="Infinity" onAction="#cancelEdit" visible="false" managed="false" styleClass="secondary-button" />
      </VBox>
    </FlowPane>
</VBox>
