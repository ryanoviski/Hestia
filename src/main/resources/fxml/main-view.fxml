<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.github.ryanoviski.hestia.presentation.controllers.MainController"
            styleClass="app-shell">
    <left>
        <VBox fx:id="navigation" prefWidth="242" styleClass="sidebar">
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="brand">
                <StackPane styleClass="brand-mark"><Label text="H" styleClass="brand-letter" /></StackPane>
                <VBox spacing="1">
                    <Label text="Hestia" styleClass="brand-name" />
                    <Label text="Finanças em harmonia" styleClass="brand-caption" />
                </VBox>
            </HBox>
            <Label text="VISÃO GERAL" styleClass="nav-section" />
            <Button text="Painel" userData="dashboard" onAction="#navigate" styleClass="nav-button" />
            <Button text="Movimentações" userData="transactions" onAction="#navigate" styleClass="nav-button" />
            <Button text="Contas a pagar" userData="bills" onAction="#navigate" styleClass="nav-button" />
            <Button text="Receitas" userData="income" onAction="#navigate" styleClass="nav-button" />
            <Button text="Recorrências" userData="recurring" onAction="#navigate" styleClass="nav-button" />
            <Button text="Parcelamentos" userData="installments" onAction="#navigate" styleClass="nav-button" />
            <Button text="Relatórios" userData="reports" onAction="#navigate" styleClass="nav-button" />
            <Label text="GESTÃO" styleClass="nav-section" />
            <Button text="Perfis" userData="profiles" onAction="#navigate" styleClass="nav-button" />
            <Button text="Categorias" userData="categories" onAction="#navigate" styleClass="nav-button" />
            <Button text="Configurações" userData="settings" onAction="#navigate" styleClass="nav-button" />
        </VBox>
    </left>
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="topbar">
            <Label fx:id="pageTitle" text="Painel" styleClass="page-title" />
        </HBox>
    </top>
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area" />
    </center>
</BorderPane>
