<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import io.github.ryanoviski.hestia.presentation.components.MonthYearPicker?>
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.github.ryanoviski.hestia.presentation.controllers.DashboardController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="view-scroll,page-viewport">
    <StackPane alignment="TOP_CENTER">
    <VBox fx:id="pageContent" spacing="22" styleClass="view,page-frame">
        <HBox alignment="CENTER_LEFT" spacing="14">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Visão do mês" styleClass="view-heading"/>
                <Label text="O essencial para entender suas finanças agora." styleClass="view-subtitle"/>
            </VBox>
            <Button text="‹" accessibleText="Mês anterior" onAction="#previousMonth" styleClass="icon-button"/>
            <MonthYearPicker fx:id="monthPicker" minWidth="210" maxWidth="210"/>
            <Button text="›" accessibleText="Próximo mês" onAction="#nextMonth" styleClass="icon-button"/>
        </HBox>
        <VBox alignment="CENTER" spacing="6" styleClass="dashboard-hero">
            <Label text="RESULTADO DO MÊS" styleClass="eyebrow"/>
            <Label fx:id="realizedResult" styleClass="hero-value"/>
            <Label fx:id="projectedResult" styleClass="hero-caption"/>
        </VBox>
        <GridPane hgap="14" vgap="14">
            <columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
            <VBox GridPane.columnIndex="0" spacing="8" styleClass="metric-panel,income-accent">
                <HBox alignment="CENTER_LEFT"><Label text="Receitas" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Label text="ENTRADAS" styleClass="eyebrow"/></HBox>
                <Label fx:id="receivedIncome" styleClass="metric-large"/>
                <Label fx:id="expectedIncome" styleClass="section-caption"/>
            </VBox>
            <VBox GridPane.columnIndex="1" spacing="8" styleClass="metric-panel,expense-accent">
                <HBox alignment="CENTER_LEFT"><Label text="Despesas" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Label text="SAÍDAS" styleClass="eyebrow"/></HBox>
                <Label fx:id="paidExpenses" styleClass="metric-large"/>
                <Label fx:id="pendingExpenses" styleClass="section-caption"/>
            </VBox>
        </GridPane>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="attention-panel">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Despesas vencidas" styleClass="section-title"/>
                <Label text="Contas pendentes com vencimento anterior a hoje" styleClass="section-caption"/>
            </VBox>
            <Label fx:id="overdueExpenses" styleClass="attention-value"/>
        </HBox>
        <GridPane hgap="14" vgap="14">
            <columnConstraints><ColumnConstraints percentWidth="58"/><ColumnConstraints percentWidth="42"/></columnConstraints>
            <VBox GridPane.columnIndex="0" spacing="13" styleClass="panel">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Próximos vencimentos" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Ver todas" onAction="#showAllUpcoming" styleClass="text-button"/>
                </HBox>
                <Label text="O que precisa da sua atenção nos próximos dias." styleClass="section-caption"/>
                <VBox fx:id="upcomingList" spacing="7"/>
                <VBox fx:id="upcomingEmpty" alignment="CENTER" spacing="5" styleClass="inline-empty">
                    <Label text="Tudo em dia por aqui" styleClass="empty-title"/>
                    <Label text="Nenhum vencimento futuro pendente." styleClass="empty-description"/>
                </VBox>
            </VBox>
            <VBox GridPane.columnIndex="1" spacing="13" styleClass="panel">
                <Label text="Maiores gastos" styleClass="section-title"/>
                <Label text="Categorias com maior impacto no período." styleClass="section-caption"/>
                <VBox fx:id="categoryTotals" spacing="11"/>
                <VBox fx:id="categoryEmpty" alignment="CENTER" spacing="5" styleClass="inline-empty">
                    <Label text="Sem despesas no período" styleClass="empty-title"/>
                    <Label text="A distribuição aparecerá quando houver lançamentos." wrapText="true" styleClass="empty-description"/>
                </VBox>
            </VBox>
        </GridPane>
    </VBox>
    </StackPane>
</ScrollPane>
