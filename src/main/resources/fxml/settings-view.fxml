<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.github.ryanoviski.hestia.presentation.controllers.SettingsController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="view-scroll,page-viewport">
    <StackPane alignment="TOP_CENTER">
    <VBox fx:id="pageContent" spacing="20" styleClass="view,page-frame,page-frame-narrow">
        <VBox spacing="4"><Label text="Configurações" styleClass="view-heading"/><Label text="Proteja seus dados e escolha como o Hestia cria cópias de segurança." styleClass="view-subtitle"/></VBox>
        <VBox spacing="14" styleClass="settings-section">
            <VBox spacing="3"><Label text="Dados e segurança" styleClass="section-title"/><Label text="O backup inclui o banco e todos os anexos verificados." styleClass="section-caption"/></VBox>
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="settings-row">
                <VBox spacing="3" HBox.hgrow="ALWAYS"><Label text="Criar backup" styleClass="setting-title"/><Label text="Salve uma cópia completa, com senha opcional." styleClass="section-caption"/></VBox>
                <Button text="Criar backup" onAction="#createBackup" styleClass="primary-button"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="settings-row">
                <VBox spacing="3" HBox.hgrow="ALWAYS"><Label text="Restaurar dados" styleClass="setting-title"/><Label text="Valide e restaure um arquivo .hestia-backup." styleClass="section-caption"/></VBox>
                <Button text="Restaurar backup" onAction="#restoreBackup" styleClass="secondary-button"/>
            </HBox>
        </VBox>
        <VBox spacing="13" styleClass="settings-section">
            <VBox spacing="3"><Label text="Backup automático" styleClass="section-title"/><Label text="Uma cópia diária no local escolhido, sem senha." styleClass="section-caption"/></VBox>
            <CheckBox fx:id="automaticEnabled" text="Fazer backup automaticamente"/>
            <Label text="Pasta de destino" styleClass="field-label"/>
            <HBox spacing="8"><TextField fx:id="automaticDirectory" promptText="Escolha uma pasta" HBox.hgrow="ALWAYS"/><Button text="Escolher pasta" onAction="#chooseDirectory" styleClass="secondary-button"/></HBox>
            <Label text="Quantidade de cópias mantidas" styleClass="field-label"/>
            <Spinner fx:id="retention" maxWidth="150"/>
            <Button text="Salvar backup automático" onAction="#saveAutomatic" maxWidth="230" styleClass="secondary-button"/>
        </VBox>
        <VBox spacing="9" styleClass="settings-section">
            <Label text="Sobre os dados" styleClass="section-title"/>
            <Label text="Local utilizado pelo Hestia neste computador" styleClass="section-caption"/>
            <Label fx:id="localDataPath" wrapText="true" styleClass="data-path"/>
            <Label text="Seus dados não são enviados para serviços externos." styleClass="info-text"/>
        </VBox>
        <VBox alignment="CENTER_LEFT" spacing="9" styleClass="settings-section,about-section">
            <ImageView fitWidth="190" preserveRatio="true" smooth="true"
                       accessibleText="Logotipo do Hestia" styleClass="about-logo">
                <image><Image url="@../images/branding/hestia-wordmark.png" /></image>
            </ImageView>
            <Label text="Gestão financeira pessoal e familiar" styleClass="setting-title"/>
            <Label text="Versão 0.1.0 — Em desenvolvimento" styleClass="section-caption"/>
        </VBox>
        <HBox alignment="CENTER_LEFT" spacing="10"><ProgressIndicator fx:id="progress" visible="false" managed="false" prefWidth="24" prefHeight="24"/><Label fx:id="status" wrapText="true" styleClass="feedback-text"/></HBox>
    </VBox>
    </StackPane>
</ScrollPane>
